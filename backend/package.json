{
  "name": "@albo/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Albo Core API and Job Worker (NestJS modular monolith)",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "bun dist/main.js",
    "start:worker": "bun dist/worker.js",
    "start:worker:dev": "bun --watch src/worker.ts",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest --config ./jest.config.ts --runInBand",
    "test:unit": "jest --config ./jest.config.ts --testPathPattern=test/unit --runInBand",
    "test:cov": "jest --config ./jest.config.ts --coverage --runInBand",
    "prisma:generate": "prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "migrate:check": "prisma migrate status",
    "seed:synthetic": "bun src/database/seeds/run-seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1177.0",
    "@aws-sdk/s3-request-presigner": "^3.1177.0",
    "@nestjs/common": "^10",
    "@nestjs/config": "^3",
    "@nestjs/core": "^10",
    "@nestjs/platform-express": "^10",
    "@nestjs/swagger": "^7",
    "@prisma/client": "^6",
    "bullmq": "^6.7.10",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.1.0",
    "jose": "^5",
    "nestjs-pino": "^4",
    "pino": "^9",
    "pino-http": "^10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3"
  },
  "devDependencies": {
    "@nestjs/cli": "^10",
    "@nestjs/testing": "^10",
    "@types/express": "^4.17.21",
    "@types/jest": "^29",
    "@types/node": "^26.6.7",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^7",
    "@typescript-eslint/parser": "^7",
    "eslint": "^8",
    "jest": "^29",
    "prettier": "^3.10.1",
    "prisma": "^6",
    "supertest": "^7.3.2",
    "ts-jest": "^29",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
