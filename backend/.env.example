# Albo Core API — Synthetic Local Development Environment Example
# Copy to .env for local development. Never commit real credentials or real patient data.

NODE_ENV=development
PORT=4000

# PostgreSQL / PostGIS (synthetic local dev credentials)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/albo_dev?schema=public # ggignore

# Redis (cache, rate limits, BullMQ background jobs — never primary health storage)
REDIS_URL=redis://127.0.0.1:6379

# Internal AI service boundary (ADR-001, ADR-013)
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TOKEN=example_placeholder_internal_service_token_local_only # ggignore
AI_SERVICE_TIMEOUT_MS=2000

# OIDC / JWT authentication boundary (ADR-005, ADR-011)
JWT_ISSUER=https://auth.synthetic.albo.invalid
JWT_AUDIENCE=albo-core-api
# JWT_JWKS_URL=https://auth.synthetic.albo.invalid/.well-known/jwks.json
JWT_HS256_SECRET=example_placeholder_jwt_signing_secret_key_local_only # ggignore

# Private S3-compatible object storage (MinIO in local dev)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=albo-synthetic-reports
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin # ggignore

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Safety feature flags / kill switches (AI_SAFETY.md §6, ADR-006)
FEATURE_ASSISTANT_ENABLED=false
FEATURE_PROVIDER_PORTAL_ENABLED=false
FEATURE_CHECKINS_ENABLED=false

# Approved risk rule versions (comma-separated use_case_code:version pairs)
APPROVED_RISK_RULE_VERSIONS=lifestyle_ncd_preventive:rules-v1.0.0
